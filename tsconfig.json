{
  "compilerOptions": {
    "target": "ES2018",
    "module": "esnext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "removeComments": true,
    "types": ["node", "vitest/globals"],
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
