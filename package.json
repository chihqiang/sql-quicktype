{
  "name": "@chihqiang/sql-quicktype",
  "version": "0.0.5",
  "description": "A tool to generate TypeScript, Go, GORM, and XORM types from SQL DDL statements",
  "scripts": {
    "build": "vite build && vite build --mode cli && vite build --mode iife",
    "build:lib": "vite build",
    "build:cli": "vite build --mode cli",
    "build:iife": "vite build --mode iife",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "run-s format format:check typecheck test build"
  },
  "keywords": [
    "sql",
    "ddl",
    "typescript",
    "go",
    "gorm",
    "xorm",
    "code-generator",
    "schema",
    "database",
    "parser"
  ],
  "author": "chihqiang",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],

  "repository": {
    "type": "git",
    "url": "https://github.com/chihqiang/sql-quicktype.git"
  },
  "bugs": {
    "url": "https://github.com/chihqiang/sql-quicktype/issues"
  },
  "homepage": "https://github.com/chihqiang/sql-quicktype#readme",
  "jsdelivr": "https://cdn.jsdelivr.net/npm/@chihqiang/sql-quicktype@latest/dist/index.global.js",
  "unpkg": "https://unpkg.com/@chihqiang/sql-quicktype@latest/dist/index.global.js",
  "sideEffects": false,
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sql-quicktype": "./dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "mysql2": "^3.16.2",
    "node-sql-parser": "^5.4.0"
  }
}
